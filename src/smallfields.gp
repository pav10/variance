\\ smallfields.gp -- distinct fields generated by totally real integers with Var <= V (deg <= 10)
read("src/gtest.gp");
smallf(D, V, out) =
{
  my(L = readstr(Str("results/spectrum/spec_d", D, ".txt")), M = Map());
  for (i = 1, #L,
    my(p = strsplit(L[i], "|"), v = eval(p[2]), f = eval(p[4]), g);
    if (v > V, next);
    g = polredabs(f);
    if (mapisdefined(M, g, &w), if (v < w[1], mapput(M, g, [v, f])), mapput(M, g, [v, f])));
  my(K = Mat(M), res = List());
  for (i = 1, matsize(K)[1],
    my(g = K[i,1], v = K[i,2][1], F = gfield(g, 0), nu = nuK(F)[1], prim = (#nfsubfields(g) == 2));
    listput(res, [nfdisc(g), g, v, nu, prim]));
  res = vecsort(Vec(res), 1);
  for (i = 1, #res, write(out, Str(D, "|", res[i][1], "|", res[i][2], "|minVar(gen)=", res[i][3], "|nu=", res[i][4], "|primitive=", res[i][5])));
  #res;
}
