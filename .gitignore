# raw enumerator output (regenerated by src/varspec.sh; up to 100 MB)
results/spectrum/raw_d*.txt
results/spectrum/*.jobs
# per-process logs and shards of running censuses
results/census/*_part*.txt
results/census/*.log
# LaTeX build artefacts
notes/*.aux
notes/*.log
notes/*.out
notes/*.toc
# per-job enumerator output (concatenated into raw.txt)
results/regime2X/out_*.txt
results/regime2X/log_*.txt
results/regime2Y/out_*.txt
results/regime2Y/log_*.txt
